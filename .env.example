# Amazon Selling Partner API (SP-API) Configuration
# Leave blank to use built-in Mock / Demo mode with realistic product catalog data

# Shared LWA Credentials (from your Amazon Developer SP-API App)
SP_API_CLIENT_ID=
SP_API_CLIENT_SECRET=

# Europe Region Refresh Token (UK, IT, FR, ES, DE, IE)
SP_API_REFRESH_TOKEN=
SP_API_REFRESH_TOKEN_EU=

# North America Region Refresh Token (USA, CA)
# Note: Amazon requires a separate authorization / refresh token for North America vs Europe selling accounts
SP_API_REFRESH_TOKEN_NA=
SP_API_REFRESH_TOKEN_USA=

# Default Marketplace ID (UK: A1F83G8C2ARO7P, USA: ATVPDKIKX0DER, Germany: A1PA6795UKMFR9, Ireland: A28R8C7GAPY1TF)
SP_API_MARKETPLACE_ID=A1F83G8C2ARO7P
SP_API_REGION=eu-west-1
